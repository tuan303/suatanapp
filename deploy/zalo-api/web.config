<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="8192" />
      </requestFiltering>
    </security>
    <rewrite>
      <rules>
        <clear />
        <rule name="DKAN Zalo API" stopProcessing="true">
          <match url="^api/zalo$" ignoreCase="false" />
          <action type="Rewrite" url="http://127.0.0.1:3031/api/zalo" appendQueryString="false" />
        </rule>
        <rule name="DKAN Zalo Webhook" stopProcessing="true">
          <match url="^api/zalo-webhook$" ignoreCase="false" />
          <action type="Rewrite" url="http://127.0.0.1:3031/api/zalo-webhook" appendQueryString="false" />
        </rule>
        <rule name="DKAN reject other paths" stopProcessing="true">
          <match url=".*" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
